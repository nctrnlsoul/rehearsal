# Sample store environment. NAMES ONLY -- never commit values.
# Set these in the store's Vercel project.

# REQUIRED. Shared secret for GET /api/store/state. Without it the endpoint
# returns 503 and reads nothing. Set the SAME value as a Windows environment
# variable so the edge-case finder can read the store's state.
REHEARSAL_STORE_TOKEN=

# REQUIRED. The same Supabase project the receiver uses, but a different table
# (store_order_events). Without BOTH, the webhook endpoint returns 503 rather
# than accepting a delivery it would then drop.
# The key is sent on the apikey header only: sb_secret_ keys are not JWTs.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OPTIONAL. With all three set, the store verifies each event's signature and
# records verified true/false. Without them it records null, which means
# "not attempted" rather than "failed".
# REHEARSAL_STORE_WEBHOOK_ID is the webhook registered for THIS app's URL; the
# finder prints it on the first run.
PAYPAL_SELLER_CLIENT_ID=
PAYPAL_SELLER_CLIENT_SECRET=
REHEARSAL_STORE_WEBHOOK_ID=
