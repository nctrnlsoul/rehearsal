{
  "name": "rehearsal",
  "version": "0.7.6",
  "private": true,
  "type": "module",
  "description": "REHEARSAL: builds a business's real PayPal sandbox state from a plan, fires real verifiable webhooks, and finds the edge cases a merchant app mishandles.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "gate:0": "tsx gate/00-preflight.ts",
    "gate:1": "tsx gate/01-card-order.ts",
    "gate:2": "tsx gate/02-partial-refund.ts",
    "gate:3": "tsx gate/03-payout-unclaimed.ts",
    "gate:4": "tsx gate/04-invoice.ts",
    "gate:5": "tsx gate/05-webhooks.ts",
    "gate:6": "tsx gate/06-dispute.ts",
    "rehearsal": "tsx bin/rehearsal.ts",
    "dry-run": "tsx bin/rehearsal.ts dry-run",
    "bank:add": "tsx bin/rehearsal.ts bank:add",
    "bank:confirm": "tsx bin/rehearsal.ts bank:confirm",
    "bank:set-txn": "tsx bin/rehearsal.ts bank:set-txn",
    "bank:list": "tsx bin/rehearsal.ts bank:list",
    "bank:export-hosted": "tsx bin/rehearsal.ts bank:export-hosted",
    "find": "tsx bin/rehearsal.ts find",
    "evals": "tsx evals/run.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.87",
    "@modelcontextprotocol/sdk": "1.32.1",
    "ai": "^7.0.151",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
