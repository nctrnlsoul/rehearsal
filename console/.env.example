# REHEARSAL console environment. NAMES ONLY: never commit values.
#
# Set these in the console's Vercel project for PRODUCTION ONLY. Never for
# Preview: a preview deployment with these values is a second live console
# with its own URL, its own gate and the same keys.
#
# Missing required values fail closed: the gate stays shut, or live runs stay
# paused, and the page says which. Recorded replays work with none of these.

# ---------------------------------------------------------------- required: the judge gate

# The passcode's scrypt hash, never the passcode. Make it with:
#   npm run hash-passcode   (reads the passcode from stdin, prints the hash)
CONSOLE_PASSCODE_HASH=

# Signs the session cookie and keys the gate's counter hashes. At least 32
# random characters, unrelated to the passcode. Rotating it signs every judge out.
CONSOLE_SESSION_SECRET=

# The console's OWN Supabase project, never the store's or the receiver's.
# Wrong tries, runs, plans, quotas and the purchase bank live here. Apply
# migrations/0001 to 0004 (and read each verify file) before deploying.
# The key is the project's SECRET key (sb_secret_...), sent on the apikey header only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- required: live runs

# The kill switch. Live runs happen only while this is exactly "on".
# Unset, or anything else, keeps them paused; replays still play.
CONSOLE_LIVE_RUNS=

# The sample store: the one place a hosted run may send events, exactly
# https://host with no path. The token is the same value the store holds.
REHEARSAL_STORE_ORIGIN=
REHEARSAL_STORE_TOKEN=

# Sandbox apps. The seller runs every step; the buyer opens disputes.
PAYPAL_SELLER_CLIENT_ID=
PAYPAL_SELLER_CLIENT_SECRET=
PAYPAL_BUYER_CLIENT_ID=
PAYPAL_BUYER_CLIENT_SECRET=

# For the planner and the hosted finder. Use a workspace with a spend limit.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- optional: can only tighten

# Each of these can lower the number in code and never raise it. A malformed
# value stops live runs rather than being ignored.
CONSOLE_MAX_RUNS_PER_DAY=
CONSOLE_MAX_RUNS_PER_SESSION=
CONSOLE_MAX_MODEL_CALLS_PER_DAY=
CONSOLE_MAX_MODEL_CALLS_PER_SESSION=
REHEARSAL_MAX_STEP_AMOUNT=
REHEARSAL_MAX_RUN_TOTAL=
REHEARSAL_MAX_STEPS=
REHEARSAL_MAX_DISPUTES=
REHEARSAL_AI_MAX_CALLS=
REHEARSAL_AI_MAX_OUTPUT_TOKENS=
REHEARSAL_AI_MAX_INPUT_CHARS=

# ---------------------------------------------------------------- optional

# The planner model. The default is set in code.
REHEARSAL_PLANNER_MODEL=

# A real sandbox payout recipient, only for a plan with a claimed payout item.
# Without it such a step fails closed instead of paying a reserved address.
REHEARSAL_PAYOUT_RECEIVER=

# ---------------------------------------------------------------- must NOT be set

# Live routes refuse to run while either is set: a hosted run fires only at
# the sample store.
# REHEARSAL_EVENT_ORIGINS
# REHEARSAL_RECEIVER_ORIGIN
