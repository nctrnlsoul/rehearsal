# REHEARSAL console environment. NAMES ONLY: never commit values.
# Set these in the console's Vercel project (Production and Preview).

# REQUIRED for the judge gate. The passcode's scrypt hash, never the passcode.
# Make it with: npm run hash-passcode   (reads the passcode from stdin, prints the hash)
# Without it the gate stays closed and says so; nothing behind it opens.
CONSOLE_PASSCODE_HASH=

# REQUIRED for the judge gate. Signs the session cookie. At least 32 random
# characters, unrelated to the passcode. Rotating it signs every judge out.
CONSOLE_SESSION_SECRET=
