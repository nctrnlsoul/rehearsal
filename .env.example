# REHEARSAL sandbox credentials. NAMES ONLY -- never commit values.
# Set these as environment variables in your OS or shell profile. Never put
# a value in a committed file or on a command line that lands in shell history.
# All four are sandbox-only. They must authenticate against
# api-m.sandbox.paypal.com; they are never sent to live PayPal.

# Merchant app (rehearsal-seller)
PAYPAL_SELLER_CLIENT_ID=
PAYPAL_SELLER_CLIENT_SECRET=

# Buyer business app (rehearsal-buyer), used for the buyer-side dispute path
PAYPAL_BUYER_CLIENT_ID=
PAYPAL_BUYER_CLIENT_SECRET=

# Gate 5 only. Public https origin of the deployed webhook receiver.
# The gate refuses any origin not on its allowlist.
REHEARSAL_RECEIVER_ORIGIN=

# Gate 5 only. Shared secret the receiver requires on its read endpoint.
REHEARSAL_RECEIVER_TOKEN=

# Gate 6 only. The BUYER-side transaction id for the disputed payment, which is
# a different id from the seller's capture id. Gate 6 tries to find it via
# buyer-side Transaction Search; set this to supply it by hand when the buyer app
# has no reporting scope, or when Transaction Search has not caught up yet.
REHEARSAL_BUYER_TRANSACTION_ID=
